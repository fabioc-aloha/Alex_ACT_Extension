{
    "name": "alex-cognitive-architecture",
    "displayName": "Alex — ACT Edition",
    "description": "Artificial Critical Thinking for GitHub Copilot. A living brain of skills, instructions, and prompts that teaches your AI to reason honestly. Successor to Alex Cognitive Architecture.",
    "version": "8.13.1",
    "publisher": "fabioc-aloha",
    "license": "PolyForm-Noncommercial-1.0.0",
    "engines": {
        "vscode": "^1.117.0"
    },
    "categories": [
        "AI",
        "Chat",
        "Extension Packs",
        "Education"
    ],
    "keywords": [
        "copilot",
        "ai",
        "critical-thinking",
        "artificial-critical-thinking",
        "act",
        "cognitive-architecture",
        "brain",
        "instructions",
        "skills",
        "prompts",
        "agents"
    ],
    "extensionDependencies": [
        "GitHub.copilot-chat"
    ],
    "activationEvents": [
        "onStartupFinished"
    ],
    "main": "./extension.js",
    "contributes": {
        "commands": [
            {
                "command": "alex-act.bootstrap",
                "title": "Bootstrap This Workspace",
                "category": "ACT"
            },
            {
                "command": "alex-act.openWalkthrough",
                "title": "Open Welcome Guide",
                "category": "Alex"
            },
            {
                "command": "alex-act.upgrade",
                "title": "Upgrade Brain",
                "category": "ACT"
            },
            {
                "command": "alex-act.status",
                "title": "Show Status",
                "category": "ACT"
            },
            {
                "command": "alex-act.statusBarMenu",
                "title": "Open Status Bar Menu",
                "category": "ACT"
            },
            {
                "command": "alex-act.migrate-from-alex-master",
                "title": "Migrate from AlexMaster",
                "category": "ACT"
            },
            {
                "command": "alex-act.rollback-migration",
                "title": "Rollback Migration",
                "category": "ACT"
            },
            {
                "command": "alex-act.clean-migration-backup",
                "title": "Clean Migration Backup",
                "category": "ACT"
            },
            {
                "command": "alex-act.convert.md-to-word",
                "title": "Convert to Word (.docx)",
                "category": "ACT Convert"
            },
            {
                "command": "alex-act.convert.md-to-html",
                "title": "Convert to HTML",
                "category": "ACT Convert"
            },
            {
                "command": "alex-act.convert.md-to-eml",
                "title": "Convert to Email (.eml)",
                "category": "ACT Convert"
            },
            {
                "command": "alex-act.convert.md-to-txt",
                "title": "Convert to Plain Text",
                "category": "ACT Convert"
            },
            {
                "command": "alex-act.convert.docx-to-md",
                "title": "Convert from Word (.docx) to Markdown",
                "category": "ACT Convert"
            },
            {
                "command": "alex-act.convert.html-to-md",
                "title": "Convert from HTML to Markdown",
                "category": "ACT Convert"
            }
        ],
        "submenus": [
            {
                "id": "alex-act.convert",
                "label": "ACT Convert"
            }
        ],
        "menus": {
            "explorer/context": [
                {
                    "submenu": "alex-act.convert",
                    "when": "resourceExtname =~ /\\.(md|docx|html|htm)$/",
                    "group": "7_modification"
                }
            ],
            "alex-act.convert": [
                {
                    "command": "alex-act.convert.md-to-word",
                    "when": "resourceExtname == .md",
                    "group": "1_from_md@1"
                },
                {
                    "command": "alex-act.convert.md-to-html",
                    "when": "resourceExtname == .md",
                    "group": "1_from_md@2"
                },
                {
                    "command": "alex-act.convert.md-to-eml",
                    "when": "resourceExtname == .md",
                    "group": "1_from_md@3"
                },
                {
                    "command": "alex-act.convert.md-to-txt",
                    "when": "resourceExtname == .md",
                    "group": "1_from_md@4"
                },
                {
                    "command": "alex-act.convert.docx-to-md",
                    "when": "resourceExtname == .docx",
                    "group": "2_to_md@1"
                },
                {
                    "command": "alex-act.convert.html-to-md",
                    "when": "resourceExtname =~ /\\.(html|htm)$/",
                    "group": "2_to_md@2"
                }
            ]
        },
        "walkthroughs": [
            {
                "id": "alex-getting-started",
                "title": "Get Started with Alex",
                "description": "Artificial Critical Thinking, in plain language. A second opinion that doesn't flinch.",
                "steps": [
                    {
                        "id": "welcome",
                        "title": "Meet Alex: Artificial Critical Thinking",
                        "description": "Most AIs agree with you. Alex was built to push back, name uncertainty, and find what you're missing.",
                        "media": {
                            "markdown": "media/walkthrough/01-welcome.md"
                        }
                    },
                    {
                        "id": "copilot-check",
                        "title": "Set up GitHub Copilot: subscription and model",
                        "description": "Copilot ships built into VS Code now. Sign in, pick the tier that matches how you'll use Alex, and choose a reasoning model for sharper critical thinking.\n[Open Chat](command:workbench.action.chat.open)",
                        "media": {
                            "markdown": "media/walkthrough/02-copilot-check.md"
                        }
                    },
                    {
                        "id": "put-to-work",
                        "title": "Put Alex to work on a real decision",
                        "description": "Don't ask a search-engine question. Bring a decision, a plan, or a claim you want pressure-tested.\n[Open Chat](command:workbench.action.chat.open)",
                        "media": {
                            "markdown": "media/walkthrough/03-put-to-work.md"
                        },
                        "completionEvents": [
                            "onCommand:workbench.action.chat.open"
                        ]
                    },
                    {
                        "id": "whats-different",
                        "title": "What Alex does that other AIs don't",
                        "description": "Two-hypothesis floor, frame audits, falsifiability, calibrated confidence, anti-sycophancy. This isn't another chatbot.\n[Open Chat](command:workbench.action.chat.open)",
                        "media": {
                            "markdown": "media/walkthrough/04-whats-different.md"
                        }
                    },
                    {
                        "id": "plugin-mall",
                        "title": "The Plugin Mall: 300+ specialized skills on demand",
                        "description": "A curated catalog of specialized skills across many categories. The core brain stays small and sharp; depth is pulled in only when your project needs it.\n[Open Copilot Chat](command:workbench.action.chat.open) and try `/mall search <keyword>` or `/mall install <skill>`.",
                        "media": {
                            "markdown": "media/walkthrough/05-practical-tools.md"
                        }
                    },
                    {
                        "id": "trust-and-help",
                        "title": "Honest answers: data, failure, where to learn more",
                        "description": "Where your data goes, how to push back when Alex is wrong, where to read the framework.",
                        "media": {
                            "markdown": "media/walkthrough/06-trust-and-help.md"
                        }
                    }
                ]
            }
        ]
    },
    "icon": "assets/icon.png",
    "galleryBanner": {
        "color": "#0f172a",
        "theme": "dark"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/fabioc-aloha/Alex_ACT_Extension"
    },
    "homepage": "https://github.com/fabioc-aloha/Alex_ACT_Extension/wiki",
    "bugs": {
        "url": "https://github.com/fabioc-aloha/Alex_ACT_Extension/issues"
    },
    "qna": "https://github.com/fabioc-aloha/Alex_ACT_Extension/discussions"
}
