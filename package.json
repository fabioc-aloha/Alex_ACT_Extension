{
    "name": "alex-cognitive-architecture",
    "displayName": "Alex — ACT Edition",
    "description": "Artificial Critical Thinking for GitHub Copilot. A living brain of skills, instructions, and prompts that teaches your AI to reason honestly. Successor to Alex Cognitive Architecture.",
    "version": "9.0.0",
    "publisher": "fabioc-aloha",
    "license": "PolyForm-Noncommercial-1.0.0",
    "engines": {
        "vscode": "^1.117.0"
    },
    "categories": [
        "AI",
        "Chat",
        "Extension Packs",
        "Education"
    ],
    "keywords": [
        "copilot",
        "ai",
        "critical-thinking",
        "artificial-critical-thinking",
        "act",
        "cognitive-architecture",
        "brain",
        "instructions",
        "skills",
        "prompts",
        "agents"
    ],
    "extensionDependencies": [
        "GitHub.copilot-chat"
    ],
    "extensionPack": [
        "GitHub.copilot-chat",
        "ms-vscode.powershell",
        "redhat.vscode-yaml",
        "bierner.markdown-mermaid",
        "DavidAnson.vscode-markdownlint"
    ],
    "activationEvents": [
        "onStartupFinished"
    ],
    "main": "./extension.js",
    "contributes": {
        "commands": [
            {
                "command": "alex-act.bootstrap",
                "title": "Bootstrap This Workspace",
                "category": "ACT"
            },
            {
                "command": "alex-act.upgrade",
                "title": "Upgrade Brain",
                "category": "ACT"
            },
            {
                "command": "alex-act.status",
                "title": "Show Status",
                "category": "ACT"
            },
            {
                "command": "alex-act.mall-search",
                "title": "Search Plugin Mall",
                "category": "ACT"
            },
            {
                "command": "alex-act.migrate-from-alex-master",
                "title": "Migrate from AlexMaster",
                "category": "ACT"
            },
            {
                "command": "alex-act.rollback-migration",
                "title": "Rollback Migration",
                "category": "ACT"
            },
            {
                "command": "alex-act.clean-migration-backup",
                "title": "Clean Migration Backup",
                "category": "ACT"
            },
            {
                "command": "alex-act.convert.md-to-word",
                "title": "Convert to Word (.docx)",
                "category": "ACT Convert"
            },
            {
                "command": "alex-act.convert.md-to-html",
                "title": "Convert to HTML",
                "category": "ACT Convert"
            },
            {
                "command": "alex-act.convert.md-to-eml",
                "title": "Convert to Email (.eml)",
                "category": "ACT Convert"
            },
            {
                "command": "alex-act.convert.md-to-txt",
                "title": "Convert to Plain Text",
                "category": "ACT Convert"
            },
            {
                "command": "alex-act.convert.docx-to-md",
                "title": "Convert to Markdown",
                "category": "ACT Convert"
            },
            {
                "command": "alex-act.convert.html-to-md",
                "title": "Convert to Markdown",
                "category": "ACT Convert"
            }
        ],
        "submenus": [
            {
                "id": "alex-act.convert",
                "label": "ACT Convert"
            }
        ],
        "menus": {
            "explorer/context": [
                {
                    "submenu": "alex-act.convert",
                    "when": "resourceExtname =~ /\\.(md|docx|html|htm)$/",
                    "group": "7_modification"
                }
            ],
            "alex-act.convert": [
                {
                    "command": "alex-act.convert.md-to-word",
                    "when": "resourceExtname == .md",
                    "group": "1_from_md@1"
                },
                {
                    "command": "alex-act.convert.md-to-html",
                    "when": "resourceExtname == .md",
                    "group": "1_from_md@2"
                },
                {
                    "command": "alex-act.convert.md-to-eml",
                    "when": "resourceExtname == .md",
                    "group": "1_from_md@3"
                },
                {
                    "command": "alex-act.convert.md-to-txt",
                    "when": "resourceExtname == .md",
                    "group": "1_from_md@4"
                },
                {
                    "command": "alex-act.convert.docx-to-md",
                    "when": "resourceExtname == .docx",
                    "group": "2_to_md@1"
                },
                {
                    "command": "alex-act.convert.html-to-md",
                    "when": "resourceExtname =~ /\\.(html|htm)$/",
                    "group": "2_to_md@2"
                }
            ]
        }
    },
    "icon": "assets/icon.png",
    "galleryBanner": {
        "color": "#0f172a",
        "theme": "dark"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/fabioc-aloha/Alex_ACT_Extension"
    },
    "homepage": "https://github.com/fabioc-aloha/Alex_ACT_Extension/wiki",
    "bugs": {
        "url": "https://github.com/fabioc-aloha/Alex_ACT_Extension/issues"
    },
    "qna": "https://github.com/fabioc-aloha/Alex_ACT_Extension/discussions"
}
